<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait: the charts share the screen. Landscape: FsaeChartsFragment makes each chart a
     screen tall and this scrolls between them. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fsae_charts_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context="com.mendhak.gpslogger.GpsMainActivity">

<LinearLayout
    android:id="@+id/fsae_charts_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/fsae_charts_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/warningColor"
        android:visibility="gone" />

    <com.mendhak.gpslogger.ui.components.StripChartView
        android:id="@+id/fsae_chart_accel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <com.mendhak.gpslogger.ui.components.StripChartView
        android:id="@+id/fsae_chart_gyro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="2" />

    <com.mendhak.gpslogger.ui.components.StripChartView
        android:id="@+id/fsae_chart_speed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1.4" />

</LinearLayout>

</ScrollView>
